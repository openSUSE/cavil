# Copy this file to ".env" next to compose.yaml and fill in the values

# Address people will use to reach Cavil. It becomes part of every SBOM identifier, so choose it once.
CAVIL_URL=https://cavil.example.org

# Random string used to sign login sessions, e.g. the output of "openssl rand -hex 32". Never share it.
CAVIL_SECRETS=

# The llama.cpp server running the Cavil model, and its API key (see docs/Setup.md). Required, Cavil gives wrong
# results without it.
CAVIL_CLASSIFIER_URL=http://host.docker.internal:5000
CAVIL_CLASSIFIER_TOKEN=

# OpenID Connect login. Without it, everyone who opens Cavil is an admin, which is only acceptable on your own
# machine.
CAVIL_OIDC_WELL_KNOWN_URL=
CAVIL_OIDC_CLIENT_ID=
CAVIL_OIDC_CLIENT_SECRET=

# Where Cavil keeps the unpacked source code of every package it reviews, and incoming uploads. This grows with every
# package and is by far the largest part of a deployment, so point it at a directory on a big disk. Without it, a
# volume managed by Docker is used, on whatever disk Docker keeps its data.
#CAVIL_DATA=/srv/cavil/data

# Where PostgreSQL keeps the database, also managed by Docker without it
#CAVIL_POSTGRES_DATA=/srv/cavil/postgres

# Login of the first administrator, who becomes admin on first login through OpenID Connect
CAVIL_ADMIN=

# Where the web interface listens, the default is only reachable from this machine
#CAVIL_LISTEN=127.0.0.1:3000

# Number of background jobs each worker runs in parallel
#CAVIL_WORKER_JOBS=4
