%       push @tags, 'unresolved' if $r->{confidence} <= 1;
%       push @tags, 'peripheral' if $r->{peripheral};
* <%== $r->{a} %> + <%== $r->{b} %> [<%== join(', ', @tags) %>] - <%== $loc %>
