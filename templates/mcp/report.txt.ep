% if ($unmatched->{total}) {

## Unmatched Snippets

<%= $unmatched->{total} %> unresolved snippet<%= $unmatched->{total} == 1 ? '' : 's' %> need review. Highest impact first (one pattern or ignore clears every identical occurrence):

%   for my $s (@{$unmatched->{rows}}) {
%     my $preview = substr(($s->{text} // '') =~ s/\s+/ /gr, 0, 120);
* <%= $s->{occurrences} %>x snippet <%= $s->{snippet_id} %> (~<%= $s->{closest_license} // 'unknown-license' %> <%= $s->{similarity} %>%): <%== $preview %>
%   }

For the full list and per-snippet detail (verbatim text, overlaps, keywords, covered-by): cavil_search_snippets(package_id=<%= $summary->{id} %>).

% }
% my @emails = @{$report->{emails} // []};
% if ($email_limit && @emails) {

## Email Addresses

Ordered by occurrences<%= @emails > $email_limit ? ", top $email_limit of " . scalar(@emails) : '' %>.

%   for my $email (@emails[0 .. ($email_limit < @emails ? $email_limit - 1 : $#emails)]) {
* `<%== $email->[0] %>`: <%== $email->[1] %>
%   }
% }

% my @urls = @{$report->{urls} // []};
% if ($url_limit && @urls) {

## URLs

Ordered by occurrences<%= @urls > $url_limit ? ", top $url_limit of " . scalar(@urls) : '' %>.

%   for my $url (@urls[0 .. ($url_limit < @urls ? $url_limit - 1 : $#urls)]) {
* `<%== $url->[0] %>`: <%== $url->[1] %>
%   }
% }

% my $legal_documents = $summary->{legal_documents};
% if ($legal_documents && @{$legal_documents->{documents}}) {

## Legal Documents

The files that state this package's terms, with the lines of each no known license pattern matched. Read
those lines: the auto-resolved snippet counts can hide them.

%   for my $document (@{$legal_documents->{documents}}) {
%     my $unexplained = $document->{unexplained};
* `<%== $document->{path} %>`: <%= $document->{lines} %> line<%= $document->{lines} == 1 ? '' : 's' %><%== $unexplained ? ", $unexplained unknown" : '' %>
%   }
%   if (my $dropped = $legal_documents->{dropped}) {
* ... <%= $dropped %> more not listed
%   }
% }
% if (@{$report->{components} // []}) {

## Vendored Components

%   for my $c (@{$report->{components}}) {
* `<%== $c->{name} %><%== length($c->{version} // '') ? '@' . $c->{version} : '' %>` (<%== $c->{type} %>)<%== length($c->{license} // '') ? ': ' . $c->{license} : '' %>
%   }
% }
