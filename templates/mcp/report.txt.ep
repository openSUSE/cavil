
% my $MAX_FILES_PER_LICENSE = 2;
%
# Legal Report

Package: <%== $summary->{package_name} %>
Id: <%== $summary->{id} %>
State: <%== $summary->{state} %>
External-Link: <%== $summary->{external_link} %>
% if (my $version = $summary->{package_version}) {
Version: <%== $version %>
% }
% if (my $declared = $summary->{package_license}{name}) {
Declared-License: <%== $declared %><%== $summary->{package_license}{spdx} ? '' : ' (not a valid SPDX expression)' %>
% }
% my $declaration = $summary->{declaration};
% my $mismatch    = $declaration && $declaration->{verdict} eq 'mismatch';
% if ($declaration && $declaration->{verdict} ne 'unknown') {
Declaration: <%== $mismatch ? 'does NOT match the licenses found in shipped code (see below)' : 'matches the licenses found in shipped code' %>
% }
% if (my $sum = $summary->{package_summary}) {
Summary: <%== $sum %>
% }
% if (my $group = $summary->{package_group}) {
Group: <%== $group %>
% }
% if (my $url = $summary->{package_url}) {
URL: <%== $url %>
% }
Shortname: <%== $summary->{package_shortname} %>
Checkout: <%== $summary->{package_checksum} %>
% my $num_files = $summary->{unpacked_files};
Unpacked: <%== $num_files %> <%== $num_files == 1 ? 'file' : 'files' %> (<%== $summary->{unpacked_size} %>)
Priority: <%== $summary->{package_priority} %>
Created: <%== Mojo::Date->new($summary->{created})->to_datetime %>



% if (my $notice = $summary->{notice}) {
## System Notice

%== $notice



% }
% if (@{$summary->{legal_review_notices}}) {
## Legal Review Notices from Packagers

%   for my $notice (@{$summary->{legal_review_notices}}) {
* <%== $notice %>
%   }



% }
% if (@{$summary->{errors}}) {
## Package File Warnings

%   for my $error (@{$summary->{errors}}) {
* <%== $error %>
%   }



% }
% if ($mismatch) {
## Declared License

The `License:` tag in the package file does not account for everything the shipped code carries. This is
the most common reason a review is rejected, and it is usually fixed by correcting the tag rather than by
changing the code - so weigh whether the found licenses are themselves acceptable before treating it as a
licensing problem. Vendored and test files are already excluded below. The declared value itself is the
Declared-License line in the header above.

%   for my $entry (@{$declaration->{undeclared}}) {
%     my @paths = map {"`$_`"} @{$entry->{files}};
%     my $more  = $entry->{count} - @paths;
* Not declared: <%== $entry->{license} %> in <%== join(', ', @paths) %><%== $more > 0 ? " (+$more more)" : '' %>
%   }
%   for my $missing (@{$declaration->{not_found}}) {
* Declared but not found: <%== $missing %>
%   }
%   if (my $peripheral = $declaration->{peripheral}) {

<%= $peripheral %> further <%= $peripheral == 1 ? 'license appears' : 'licenses appear' %> only in vendored or test files, which is normal for an aggregation and is not counted above.
%   }



% }
## Licenses
% use Cavil::ReportUtil qw(ranked_incompatibilities incompatibility_location);
% my $ranked = ranked_incompatibilities($report->{license_compatibility} // {});
% if (@$ranked) {
%   my (@investigate, $peripheral, $weak, $distant);
%   for my $r (@$ranked) {
%     my $loc = incompatibility_location($r);
%     if ($r->{confidence} >= 2 && !$r->{peripheral} && $loc) { push @investigate, [$r, $loc] }
%     elsif ($r->{peripheral})            { $peripheral++ }
%     elsif ($r->{confidence} == 1 && $loc) { $weak++ }
%     else                                { $distant++ }
%   }

### Incompatible Licenses

OSADL flags these pairs as incompatible when combined into one work. Proximity locates the code but is not
proof - confirm with cavil_get_file.

%   if (@investigate) {
Worth investigating (co-located in shipped code):
%     for my $pair (@investigate) {
%       my ($r, $loc) = @$pair;
