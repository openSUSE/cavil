# Code search

% if ($too_short) {
Snippet too short or too repetitive to locate reliably; try a longer or more distinctive sample.
% }
% elsif (!@$matches) {
No matching open source code found.
% }
% for my $m (@$matches) {
match <%= $m->{hash} %> · <%= $m->{aligned} %>/<%= $m->{total} %> fingerprints aligned (<%= $m->{exact} ? 'exact' : 'modified' %>) · <%= int($m->{containment_of} * 100 + 0.5) %>% of file<%= defined $m->{risk} ? " · risk $m->{risk}" : '' %>
%   for my $f (@{$m->{files}}) {
  <%= $f->{name} %>: <%= $f->{filename} %> (package_id <%= $f->{package} %>)
%   }
% }
